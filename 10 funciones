

# 1. divmod(a, b)
# Devuelve una tupla con el cociente y el residuo de la división entera (a // b, a % b).
total_carga = 68
capacidad_contenedor = 15
contenedores, residuo = divmod(total_carga, capacidad_contenedor)
print(f"1. divmod -> Contenedores llenos: {contenedores}, Carga restante: {residuo} ton")


# 2. zip(*iterables)
# Agrupa elementos de múltiples iterables posición por posición.
estaciones = ["E1", "E2", "E3"]
caudales = [12.5, 14.1, 9.8]
reporte = list(zip(estaciones, caudales))
print(f"2. zip -> Reporte agrupado: {reporte}")


# 3. any(iterable)
# Devuelve True si al menos un elemento del iterable es verdadero.
lecturas_presion = [1.2, 1.5, 2.8, 4.1]  # Límite crítico: > 4.0
alerta_activa = any(p > 4.0 for p in lecturas_presion)
print(f"3. any -> ¿Hay alerta de presión superada?: {alerta_activa}")


# 4. all(iterable)
# Devuelve True solo si TODOS los elementos del iterable son verdaderos.
resistencias_MPa = [21.5, 22.0, 21.8, 21.2]  # Mínimo requerido: 21.0 MPa
lote_aprobado = all(r >= 21.0 for r in resistencias_MPa)
print(f"4. all -> ¿Lote aprobado por completo?: {lote_aprobado}")


# 5. pow(base, exp, mod)
# Eleva un número a una potencia y opcionalmente calcula el módulo de forma eficiente.
resultado_pow = pow(7, 256, 13)
print(f"5. pow -> Resultado de la exponenciación modular: {resultado_pow}")


# 6. slice(start, stop, step)
# Crea un objeto de corte reutilizable para secuencias.
cortador = slice(1, 6, 2)
datos = [10, 20, 30, 40, 50, 60]
print(f"6. slice -> Datos recortados: {datos[cortador]}")


# 7. hash(object)
# Devuelve el valor hash único de un objeto inmutable.
codigo_proyecto = "PROYECTO_CIVIL_2026"
print(f"7. hash -> Identificador hash: {hash(codigo_proyecto)}")


# 8. callable(object)
# Verifica si un objeto se puede llamar como una función.
def mi_funcion():
    pass

variable_numero = 45
print(f"8. callable -> ¿La función es invocable?: {callable(mi_funcion)}")
print(f"8. callable -> ¿La variable numérica es invocable?: {callable(variable_numero)}")


# 9. memoryview(obj)
# Permite acceder al búfer de bytes de un objeto sin copiarlo en memoria.
datos_binarios = b"IngenieriaCivilPython"
vista = memoryview(datos_binarios)
print(f"9. memoryview -> Primer byte en ASCII: {vista[0]}")
print(f"9. memoryview -> Sub-vista en bytes: {vista[5:16].tobytes()}")


# 10. locals() y globals()
# Devuelven diccionarios con las variables del ámbito local y global respectivamente.
parametro_a = 100
parametro_b = 200

print("10. locals -> Variables locales registradas:")
for nombre, valor in locals().items():
    if not nombre.startswith('__') and nombre != 'vista':
        print(f"    - {nombre}: {valor}")
